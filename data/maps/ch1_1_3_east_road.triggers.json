      "when": {
        "event": "visit",
        "name": "Root-Grown Mine",
        "after": "wardens_won"
      },
      "do": [
        {
          "choice": {
            "id": "roots",
            "title": "The Roots",
            "text": "Roots have grown across the mine mouth. Someone cut through them not long ago, and they have closed again.",
            "options": [
              {
                "id": "cut",
                "label": "Cut the roots",
                "then": [
                  {
                    "ending": {
                      "id": "the_roots",
                      "heading": "The Roots",
                      "body": "You cut through the roots and go down into the dark after him.",
                      "frames": [
                        {
                          "scene": "road",
                          "text": "The roots part under the axe.\nCold air rises out of the dark."
                        },
                        {
                          "scene": "road",
                          "text": "Aldren went this way.\nSo do you."
                        }
                      ]
                    }
                  }
                ]
              },
              {
                "id": "turn_back",
                "label": "Turn back",
                "then": []
              }
            ]
          }
        }
      ]
    },
