{
  "start_companions": [
    "drest"
  ],
  "quests": [
    {
      "id": "aldren",
      "title": "Where did Aldren go?",
      "text": "The east road climbs toward the mountains. Follow it to its end.",
      "main": true
    }
  ],
  "triggers": [
    {
      "id": "start",
      "when": {
        "event": "start"
      },
      "do": [
        {
          "quest": "aldren"
        }
      ]
    },
    {
      "id": "cold_fire",
      "when": {
        "event": "visit",
        "name": "Cold Fire"
      },
      "do": [
        {
          "lore": [
            "A cold fire",
            "Ashes banked the careful way Aldren always banked them. Grass flattened for one bedroll."
          ]
        },
        {
          "say": [
            [
              "Drest",
              "I taught him to bank a fire like that. He was listening, then."
            ]
          ]
        }
      ]
    },
    {
      "id": "bridge_post",
      "when": {
        "event": "visit",
        "name": "Bridge Post"
      },
      "do": [
        {
          "lore": [
            "The bridge post",
            "Cut into the post with a knife: an arrow pointing east, and an A, in the hand of his letter."
          ]
        }
      ]
    },
    {
      "id": "broken_camp",
      "when": {
        "event": "visit",
        "name": "Broken Camp"
      },
      "if": {
        "all": [
          {
            "companion": "ushari"
          },
          {
            "not": {
              "trigger_fired": "ushari_road"
            }
          }
        ]
      },
      "do": [
        {
          "scene": {
            "frames": [
              {
                "scene": "road",
                "text": "Ushari's people camped here.\nTheir tents are cut down, their packs slit open."
              },
              {
                "scene": "road",
                "text": "No one is left.\nOn the cart, someone has painted a red hand."
              }
            ]
          }
        },
        {
          "if": {
            "flag": "choice.red_banner",
            "is": "drive_off"
          },
          "then": [
            {
              "say": [
                [
                  "Ushari",
                  "The red hands. You drove them from your bridge, and they came this way."
                ]
              ]
            }
          ],
          "else": [
            {
              "if": {
                "flag": "choice.red_banner",
                "is": "let_pass"
              },
              "then": [
                {
                  "say": [
                    [
                      "Ushari",
                      "The red hands. You let them over your bridge, and they came this way."
                    ]
                  ]
                }
              ],
              "else": [
                {
                  "if": {
                    "flag": "choice.red_banner",
                    "is": "make_pay"
                  },
                  "then": [
                    {
                      "say": [
                        [
                          "Ushari",
                          "The red hands. They paid you for your bridge, and took it back from my people."
                        ]
                      ]
                    }
                  ],
                  "else": [
                    {
                      "say": [
                        [
                          "Ushari",
                          "Red hands. They came in the night."
                        ]
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "if": {
            "flag": "choice.camp_strangers",
            "is": "grant"
          },
          "then": [
            {
              "say": [
                [
                  "Ushari",
                  "You let us rest on your fields. I should have kept them there one more day."
                ]
              ]
            }
          ],
          "else": [
            {
              "if": {
                "flag": "choice.camp_strangers",
                "is": "tax"
              },
              "then": [
                {
                  "say": [
                    [
                      "Ushari",
                      "We paid your toll for a safe road. This is your road."
                    ]
                  ]
                }
              ],
              "else": [
                {
                  "if": {
                    "flag": "choice.camp_strangers",
                    "is": "turn_away"
                  },
                  "then": [
                    {
                      "say": [
                        [
                          "Ushari",
                          "You turned us off your fields. They had nowhere to wait for me."
                        ]
                      ]
                    }
                  ],
                  "else": [
                    {
                      "say": [
                        [
                          "Ushari",
                          "I sent them on ahead. I should have ridden with them."
                        ]
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "ushari_road",
      "when": {
        "event": "visit",
        "name": "Broken Camp"
      },
      "if": {
        "all": [
          {
            "not": {
              "companion": "ushari"
            }
          },
          {
            "not": {
              "trigger_fired": "broken_camp"
            }
          },
          {
            "not": {
              "flag": "choice.red_banner"
            }
          }
        ]
      },
      "do": [
        {
          "choice": {
            "id": "ushari_road",
            "title": "The Broken Camp",
            "text": "A camp lies broken by the road: tents cut down, packs slit open, a red hand painted on the cart. One woman is still standing.",
            "options": [
              {
                "id": "take",
                "label": "Take her with you",
                "then": [
                  {
                    "join": "ushari"
                  }
                ]
              },
              {
                "id": "send_home",
                "label": "Send her home",
                "then": []
              }
            ],
            "presentation": "conversation",
            "lines": [
              [
                "Ushari",
                "I am Ushari. Red hands came in the night. I am the last of us."
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "wardens_won",
      "when": {
        "event": "encounter_won",
        "name": "Root Wardens"
      },
      "do": []
    },
    {
