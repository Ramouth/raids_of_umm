{
  "start_companions": [
    "aldren",
    "drest"
  ],
  "quests": [
    {
      "id": "hunt",
      "title": "The Last Hunt",
      "text": "Two packs of dogs have been killing the herds. They foam at the mouth and do not run from people. Hunt them down with Aldren.",
      "main": true
    },
    {
      "id": "hall",
      "title": "The Hall",
      "text": "The hunt is over. End the day: your father is waiting in the hall.",
      "main": false
    }
  ],
  "triggers": [
    {
      "id": "start",
      "when": {
        "event": "start"
      },
      "do": [
        {
          "quest": "hunt"
        },
        {
          "reveal": [
            0,
            0,
            10
          ]
        },
        {
          "say": [
            [
              "Herdsman",
              "They came right into the fold, my lord. They bit my boy."
            ],
            [
              "Aldren",
              "Two packs before dark. Keep up, little brother."
            ],
            [
              "Drest",
              "I taught you both the same lessons. Only one of you waits for the old man."
            ]
          ]
        }
      ]
    },
    {
      "id": "hunt_done",
      "when": {
        "event": "cleared",
        "names": [
          "Thicket Dogs",
          "Stream Dogs"
        ]
      },
      "do": [
        {
          "quest_done": "hunt"
        },
        {
          "quest": "hall"
        },
        {
          "say": [
            [
              "Aldren",
              "Dogs don't fight like that. Something is wrong with them."
            ],
            [
              "Drest",
              "Burn the carcasses. Don't let the herdsmen touch them."
            ]
          ]
        }
      ]
    },
    {
      "id": "carved_a",
      "when": {
        "event": "encounter_won",
        "name": "Thicket Dogs"
      },
      "if": {
        "companion": "aldren"
      },
      "do": [
        {
          "scene": {
            "frames": [
              {
                "scene": "road",
                "text": "Aldren cuts an A into the bark with his knife."
              }
            ]
          }
        },
        {
          "say": [
            [
              "Aldren",
              "So they know who cleared this wood."
            ]
          ]
        }
      ]
    },
    {
      "id": "banked_fire",
      "when": {
        "event": "visit",
        "name": "Poachers' Fire"
      },
      "if": {
        "companion": "aldren"
      },
      "do": [
        {
          "scene": {
            "frames": [
              {
                "scene": "road",
                "text": "Aldren kneels and banks the old fire:\nash over the coals, stones round the edge."
              }
            ]
          }
        },
        {
          "say": [
            [
              "Drest",
              "Every fire, every time. The rain would do it for you."
            ],
            [
              "Aldren",
              "You taught me."
            ]
          ]
        }
      ]
    },
    {
      "id": "toast",
      "when": {
        "event": "night",
        "after": "hunt_done"
