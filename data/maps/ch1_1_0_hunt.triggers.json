      "do": [
        {
          "quest_done": "hall"
        },
        {
          "scene": {
            "frames": [
              {
                "scene": "home",
                "text": "That night, in the hall,\nyour father stands and lifts his cup."
              }
            ]
          }
        },
        {
          "say": [
            [
              "Your father",
              "To Aldren. To my heir."
            ]
          ]
        },
        {
          "scene": {
            "frames": [
              {
                "scene": "home",
                "text": "Every cup in the hall goes up.\nAldren drinks, and does not look at you."
              }
            ]
          }
        },
        {
          "event": "dawn"
        }
      ]
    },
    {
      "id": "dawn",
      "when": {
        "event": "dawn"
      },
      "do": [
