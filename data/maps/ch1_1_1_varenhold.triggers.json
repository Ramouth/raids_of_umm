      },
      "do": [
        {
          "xp": 85
        },
        {
          "quest_done": "dogs"
        },
        {
          "quest_text": [
            "aldren",
            "The rabid dogs are dead. The Bridge Keeper will open the east bridge now."
          ]
        }
      ]
    },
    {
      "id": "gate_open",
      "when": {
        "event": "visit",
        "name": "Bridge Keeper",
        "after": "vale_cleared"
      },
      "do": [
        {
          "say": [
            [
              "Bridge Keeper",
              "Lord Aldren crossed at first light, before we shut it."
