  "quests": [
    {
      "id": "aldren",
      "title": "Where did Aldren go?",
      "text": "Aldren rode out at dawn and left you his sword. The only road out of the vale runs east, over the bridge.",
      "main": true
    },
    {
      "id": "dogs",
      "title": "Rabid Dogs in the Vale",
      "text": "Three packs of rabid dogs are loose in the vale. Kill them before they get at the herds.",
      "main": false
    }
  ],
