          "choice": {
            "id": "stranger",
            "title": "The Hooded Stranger",
            "text": "A hooded man stands among the dogs.",
            "options": [
              {
                "id": "hear",
                "label": "Hear him out",
                "then": [
                  {
                    "say": [
                      [
                        "Hooded Man",
                        "Your brother would not listen either. Keep this warm."
                      ]
                    ]
                  },
                  {
                    "item": "hermits_seed"
                  }
                ]
              },
              {
                "id": "attack",
                "label": "Attack",
                "then": []
              }
            ],
            "presentation": "conversation",
            "lines": [
              [
                "Hooded Man",
                "Son of Varen."
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "stranger_gone",
      "when": {
        "event": "encounter_won",
        "name": "Hollow Dogs"
      },
      "do": [
        {
          "vanish": "Hooded Stranger"
        },
        {
          "say": [
            [
              "Scout",
              "He is gone. Only roots, pushed up through frozen ground."
            ]
          ]
        }
      ]
    },
    {
      "id": "rune_stone",
      "when": {
        "event": "visit",
        "name": "Vale Rune Stone"
      },
      "do": [
        {
          "lore": [
            "A rubbing of the rune stone",
            "Charcoal on cloth. No one at Varenhold can read it."
          ]
        }
      ]
    },
    {
      "id": "barrow",
      "when": {
        "event": "visit",
        "name": "Varen Barrow"
      },
      "do": [
        {
          "say": [
            [
              "Scout",
              "The door will not open."
            ]
          ]
        }
      ]
    },
    {
      "id": "gate_shut",
      "when": {
        "event": "visit",
        "name": "Bridge Keeper",
        "unless": "vale_cleared"
      },
      "do": [
        {
          "say": [
            [
              "Bridge Keeper",
              "We won't open until the rabid dogs are killed."
            ]
          ]
        }
      ]
    },
    {
      "id": "vale_cleared",
      "when": {
        "event": "cleared",
